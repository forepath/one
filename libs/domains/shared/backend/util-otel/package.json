{
  "name": "@forepath/shared/backend/util-otel",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./metrics": {
      "types": "./src/metrics.d.ts",
      "default": "./src/metrics.js"
    },
    "./bullmq": {
      "types": "./src/bullmq.d.ts",
      "default": "./src/bullmq.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-prometheus": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@valkey/valkey-glide": "2.6.0",
    "bullmq": "5.81.5",
    "express": "4.22.3",
    "nestjs-otel": "8.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1"
  }
}
