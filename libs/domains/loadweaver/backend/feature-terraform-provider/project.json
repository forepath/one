        "main": "libs/domains/loadweaver/backend/feature-terraform-provider/src/index.ts",
        "tsConfig": "libs/domains/loadweaver/backend/feature-terraform-provider/tsconfig.lib.json",
        "assets": [
          "libs/domains/loadweaver/backend/feature-terraform-provider/*.md"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/domains/loadweaver/backend/feature-terraform-provider/jest.config.cts"
      }
    }
