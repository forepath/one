{
  "name": "loadweaver-shared-util-app-catalog",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domains/loadweaver/shared/util-app-catalog/src",
  "projectType": "library",
  "tags": ["domain:loadweaver", "scope:shared", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/domains/loadweaver/shared/util-app-catalog",
        "main": "libs/domains/loadweaver/shared/util-app-catalog/src/index.ts",
        "tsConfig": "libs/domains/loadweaver/shared/util-app-catalog/tsconfig.lib.json",
        "assets": ["libs/domains/loadweaver/shared/util-app-catalog/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/domains/loadweaver/shared/util-app-catalog/jest.config.cts"
      }
    }
  }
}
