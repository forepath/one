{
  "name": "loadweaver-shared-util-agent-protocol",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domains/loadweaver/shared/util-agent-protocol/src",
  "projectType": "library",
  "tags": ["domain:loadweaver", "scope:shared", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/domains/loadweaver/shared/util-agent-protocol",
        "main": "libs/domains/loadweaver/shared/util-agent-protocol/src/index.ts",
        "tsConfig": "libs/domains/loadweaver/shared/util-agent-protocol/tsconfig.lib.json",
        "assets": ["libs/domains/loadweaver/shared/util-agent-protocol/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/domains/loadweaver/shared/util-agent-protocol/jest.config.cts"
      }
    },
    "freeze-protocol": {
      "executor": "nx:run-commands",
      "options": {
        "command": "LW_FREEZE_AGENT_PROTOCOL=1 npx jest -c libs/domains/loadweaver/shared/util-agent-protocol/jest.config.cts src/compat/freeze.spec.ts --maxWorkers=1"
      }
    }
  }
}
