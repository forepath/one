          "pattern": "^[0-9a-f]{16}$"
        },
        "sealedShare": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "required": ["requestId", "keyId", "sealedShare"],
      "additionalProperties": false
    },
    "vpnSessions": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessions": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "publicKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw480]=$"
              },
              "endpoint": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latestHandshake": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rxBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "txBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "publicKey",
              "endpoint",
              "latestHandshake",
              "rxBytes",
              "txBytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["sessions"],
      "additionalProperties": false
    },
    "workloadIdentityRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "requests": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,63}\\/[a-z0-9-]{1,63}\\/[a-z0-9_.-]{1,63}$"
              },
              "csrPem": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": ["identity", "csrPem"],
            "additionalProperties": false
          }
        }
      },
      "required": ["requests"],
      "additionalProperties": false
    },
    "workloadStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workloads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 256
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "pulling",
                  "starting",
                  "running",
                  "healthy",
                  "unhealthy",
                  "exited",
                  "failed"
                ]
              },
              "exitCode": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "message": {
                "type": "string",
                "maxLength": 2048
              },
              "specHash": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": ["id", "state", "specHash"],
            "additionalProperties": false
          }
        }
      },
      "required": ["workloads"],
      "additionalProperties": false
    }
  }
}
