{
  "name": "loadweaver-shared-util-release",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domains/loadweaver/shared/util-release/src",
  "projectType": "library",
  "tags": ["domain:loadweaver", "scope:shared", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/domains/loadweaver/shared/util-release",
        "main": "libs/domains/loadweaver/shared/util-release/src/index.ts",
        "tsConfig": "libs/domains/loadweaver/shared/util-release/tsconfig.lib.json",
        "assets": ["libs/domains/loadweaver/shared/util-release/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/domains/loadweaver/shared/util-release/jest.config.cts"
      }
    },
    "build-bundle": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx esbuild libs/domains/loadweaver/shared/util-release/scripts/build-bundle.ts --bundle --platform=node --target=node22 --log-level=warning --outfile=tmp/lw-release/build-bundle.cjs && node tmp/lw-release/build-bundle.cjs",
        "forwardAllArgs": true
      }
    },
    "apt-snapshot": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx esbuild libs/domains/loadweaver/shared/util-release/scripts/apt-snapshot.ts --bundle --platform=node --target=node22 --log-level=warning --outfile=tmp/lw-release/apt-snapshot.cjs && node tmp/lw-release/apt-snapshot.cjs",
        "forwardAllArgs": true
      }
    },
    "dev-bundle": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "forwardAllArgs": true,
        "command": "npx nx run loadweaver-backend-node-agent:sea && npx esbuild libs/domains/loadweaver/shared/util-release/scripts/build-bundle.ts --bundle --platform=node --target=node22 --log-level=warning --outfile=tmp/lw-release/build-bundle.cjs && node tmp/lw-release/build-bundle.cjs --agent-amd64 dist/apps/loadweaver/backend-node-agent/sea/loadweaver-agent --out dist/loadweaver-dev-bundle"
      }
    }
  }
}
