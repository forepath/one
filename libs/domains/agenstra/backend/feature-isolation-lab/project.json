{
  "name": "agenstra-backend-feature-isolation-lab",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domains/agenstra/backend/feature-isolation-lab/src",
  "projectType": "library",
  "tags": ["domain:agenstra", "scope:backend", "type:feature"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/domains/agenstra/backend/feature-isolation-lab/jest.config.cts"
      }
    },
    "isolation-lab": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}-lab"],
      "options": {
        "jestConfig": "libs/domains/agenstra/backend/feature-isolation-lab/jest.isolation-lab.config.cts",
        "runInBand": true
      },
      "cache": false
    },
    "isolation-lab-cleanup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash libs/domains/agenstra/backend/feature-isolation-lab/src/integration/cleanup.sh"
      },
      "cache": false
    }
  }
}
