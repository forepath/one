sequenceDiagram
    participant Client as HTTP Client
    participant API as AgentsFilesController<br/>(/api/agents/:id/files)
    participant FileService as AgentFileSystemService
    participant AgentService as AgentsService
    participant Docker as DockerService
    participant Container as Agent Container<br/>(/app)

    Note over Client,Container: HTTP API - Agent File System (raw bytes)

    rect rgb(230, 240, 255)
        Note over Client,Container: Read File
        Client->>API: GET /api/agents/{id}/files/{path}?context=app|config<br/>optional Range / download=true
        API->>FileService: readFile(agentId, filePath, context)
        FileService->>FileService: sanitizePath(filePath)
        FileService->>AgentService: findOne(agentId)
        AgentService-->>FileService: agent entity
        FileService->>Docker: copyFileFromContainer
        Docker->>Container: docker cp / archive
        Container-->>Docker: file bytes
        Docker-->>FileService: host temp file
        FileService->>FileService: classifyAgentFile → X-File-Type + Content-Type
        FileService-->>API: AgentFileReadResult (buffer, fileType, contentType, size)
        alt Range request
            API-->>Client: 206 Partial Content<br/>Accept-Ranges, Content-Range, X-File-Type<br/>raw bytes slice
        else full
            API-->>Client: 200 OK<br/>Accept-Ranges, X-File-Type, Content-Type<br/>raw bytes
        end
    end

    rect rgb(240, 255, 240)
        Note over Client,Container: Write File (single or chunked)
        Client->>API: PUT /api/agents/{id}/files/{path}?context=app|config<br/>raw body + optional Content-Range / X-Upload-Id
        alt Content-Range present
            API->>FileService: writeFileChunk(...)
            FileService->>FileService: stage sequential chunks
            alt last chunk
                FileService->>Docker: write assembled bytes to container
                Docker->>Container: write file
            end
        else full body
            API->>FileService: writeFile(agentId, path, buffer, context)
            FileService->>Docker: write bytes to container
            Docker->>Container: write file
        end
        FileService-->>API: void
        API-->>Client: 204 No Content
    end

    rect rgb(255, 240, 240)
        Note over Client,Container: List Directory
        Client->>API: GET /api/agents/{id}/files?path={dir}&context=app|config
        API->>FileService: listDirectory(agentId, path, context)
        FileService->>Docker: list container directory
        FileService-->>API: FileNodeDto[]
        API-->>Client: 200 OK<br/>[file nodes]
    end

    rect rgb(255, 255, 230)
        Note over Client,Container: Create File/Directory
        Client->>API: POST /api/agents/{id}/files/{path}<br/>{type}
        API->>FileService: createFileOrDirectory(agentId, path, type)
        alt type === directory
            FileService->>Docker: mkdir -p
        else type === file
            FileService->>Docker: touch (empty; content via PUT)
        end
        API-->>Client: 201 Created
    end
