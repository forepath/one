sequenceDiagram
    participant User
    participant WS as Agents Gateway
    participant Pty as OpenCode PTY Service
    participant OC as OpenCode serve

    rect rgb(220, 255, 220)
        Note over User,OC: Step 1 - Create Terminal Session

        User->>WS: createTerminal {sessionId?, shell?}
        WS->>WS: Verify authentication (socket.id -> agentId)
        alt Not authenticated
            WS-->>User: error {UNAUTHORIZED}
        else Authenticated
            WS->>WS: Get agent entity (find containerId)
            alt Container not found
                WS-->>User: error {TERMINAL_ERROR}
            else Container found
                WS->>Pty: open(agentId, containerId, sessionId, shell)
                Pty->>OC: POST /pty + connect-token + WebSocket
                Pty-->>WS: session registered
                WS->>WS: Track session (socket.id -> sessionId)
                WS-->>User: terminalCreated {sessionId}
            end
        end
    end

    rect rgb(220, 255, 220)
        Note over User,OC: Step 2 - Send Terminal Input

        User->>WS: terminalInput {sessionId, data}
        WS->>WS: Verify authentication
        WS->>WS: Verify session belongs to socket.id
        alt Session not found or access denied
            WS-->>User: error {TERMINAL_ERROR}
        else Session valid
            WS->>Pty: write(sessionId, data)
            Pty->>OC: WebSocket send
        end
    end

    rect rgb(220, 255, 220)
        Note over User,OC: Step 3 - Receive Terminal Output

        OC->>Pty: WebSocket output
        Pty->>WS: onOutput callback
        WS->>WS: Format as terminalOutput event
        WS-->>User: terminalOutput {sessionId, data}
    end

    rect rgb(220, 255, 220)
        Note over User,OC: Step 4 - Resize Terminal

        User->>WS: terminalResize {sessionId, cols, rows}
        WS->>Pty: resize(sessionId, cols, rows)
        Pty->>OC: PATCH /pty/{ptyID}
    end

    rect rgb(220, 255, 220)
        Note over User,OC: Step 5 - Close Terminal Session

        User->>WS: closeTerminal {sessionId}
        WS->>WS: Verify authentication
        WS->>WS: Verify session belongs to socket.id
        alt Session not found or access denied
            WS-->>User: error {TERMINAL_ERROR}
        else Session valid
            WS->>Pty: close(sessionId)
            Pty->>OC: DELETE /pty/{ptyID}
            WS->>WS: Remove session tracking
            WS-->>User: terminalClosed {sessionId}
        end
    end

    rect rgb(255, 220, 220)
        Note over User,OC: Step 6 - PTY Exit (remote)

        OC->>Pty: WebSocket close
        Pty->>WS: onClosed callback
        WS->>WS: Remove session tracking
        WS-->>User: terminalClosed {sessionId}
    end

    rect rgb(255, 220, 220)
        Note over User,OC: Step 7 - Disconnect (WebSocket)

        User->>WS: Disconnect
        WS->>WS: Get all sessions for socket.id
        WS->>Pty: closeAll(sessionIds)
        WS->>WS: Remove socket tracking
    end
