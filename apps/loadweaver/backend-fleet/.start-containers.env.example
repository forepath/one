# Local-only defaults for the container stack. Replace placeholders before exposing it.
# Application and database ports
HOST=0.0.0.0
PORT=3500
NODE_ENV=development

# Database configuration (the fleet has its own database; it never shares one with a cluster)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=loadweaver_fleet
# TypeORM log levels (comma-separated, e.g. error,warn,query); empty uses the defaults
TYPEORM_LOGGING=

# CORS configuration (comma-separated list of allowed origins; the console serving the fleet views)
# Socket.IO resolves WEBSOCKET_CORS_ORIGIN → CORS_ORIGIN → *
CORS_ORIGIN=http://localhost:4602
WEBSOCKET_CORS_ORIGIN=
# The fleet console's URL(s), comma-separated: where a cluster's Git account OAuth callback may return (default: CORS_ORIGIN)
FLEET_CONSOLE_URL=

# Encrypts the clusters' service credentials at rest (32 bytes, base64)
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Authentication method: api-key | keycloak | users (default: api-key)
# - api-key: Static API key auth (requires STATIC_API_KEY); the key is a fleet admin
# - keycloak: Keycloak OAuth2 (requires Keycloak env vars)
# - users: Built-in user registration with JWT (requires JWT_SECRET)
AUTHENTICATION_METHOD=users

# Environment variables for disabling signup
DISABLE_SIGNUP=false
# When false (default), users-mode login requires email OTP (or TOTP if enrolled).
DISABLE_FORCE_LOGIN_2FA=false

# Environment variables for static API key authentication (when AUTHENTICATION_METHOD=api-key)
STATIC_API_KEY=local-development-loadweaver-fleet-api-key

# Environment variables for users authentication (when AUTHENTICATION_METHOD=users)
JWT_SECRET=local-development-loadweaver-fleet-jwt-secret-change-before-deployment
# TOTP issuer shown in authenticator apps (otpauth label). Defaults to Forepath when unset.
PRODUCT_NAME=Loadweaver Fleet

# Environment variables for Keycloak authentication (when AUTHENTICATION_METHOD=keycloak)
KEYCLOAK_SERVER_URL=
KEYCLOAK_AUTH_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TOKEN_VALIDATION=online

# Rate limiting (empty = enabled in production only)
RATE_LIMIT_ENABLED=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Cluster endpoints (SSRF guardrails, like Agenstra's CLIENT_ENDPOINT_* settings)
# Hostnames clusters may be registered with (comma-separated, or *); required in production
FLEET_CLUSTER_ENDPOINT_ALLOWED_HOSTS=
# Allow private / loopback cluster hosts (fleet and clusters in one private network, local labs)
FLEET_CLUSTER_ENDPOINT_ALLOW_INTERNAL_HOST=true
# Allow http:// cluster endpoints (never in production)
FLEET_CLUSTER_ENDPOINT_ALLOW_INSECURE_HTTP=true
# TLS verification of cluster endpoints (false only outside production)
FLEET_CLUSTER_TLS_REJECT_UNAUTHORIZED=true

# Relay and aggregation limits
FLEET_CLUSTER_REQUEST_TIMEOUT_MS=10000
FLEET_RELAY_TIMEOUT_MS=60000
FLEET_RELAY_MAX_REQUEST_BYTES=11534336
FLEET_RELAY_MAX_RESPONSE_BYTES=1073741824
# Backup archive transfers of cross-cluster restores (export + import)
FLEET_TRANSFER_TIMEOUT_MS=21600000
# How long fleet views reuse what they fetched from a cluster
FLEET_CACHE_TTL_MS=30000
# Health polls and the operations coordinator (cron, UTC)
FLEET_HEALTH_POLL_CRON=* * * * *
FLEET_OPERATIONS_CRON=* * * * *
# Socket.IO namespace of the socket relay
LOADWEAVER_FLEET_WEBSOCKET_NAMESPACE=socket/fleet

# Valkey (BullMQ queues, caches, update state). VALKEY_* and legacy REDIS_* both work; when both are set, CACHE_CLIENT picks the winner (glide: VALKEY_*, ioredis: REDIS_*).
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0
VALKEY_KEY_PREFIX=loadweaver-fleet
# Client library for all Valkey connections (BullMQ queues, caches, update state): glide (Valkey GLIDE, default) or ioredis.
CACHE_CLIENT=glide
QUEUE_ROLE=all
QUEUE_WORKER_CONCURRENCY=5
QUEUE_BULL_BOARD_ENABLED=true
QUEUE_BULL_BOARD_PATH=/admin/queues
QUEUE_BULL_BOARD_USERNAME=admin
QUEUE_BULL_BOARD_PASSWORD=local-development-bull-board-password

# SMTP / transactional email (MailHog when using docker-compose; login codes in users mode)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_HOST_PORT=1028
MAILHOG_HOST_PORT=8028
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@localhost
EMAIL_COMPANY_NAME=
EMAIL_COMPANY_ADDRESS_LINE1=
EMAIL_COMPANY_POSTAL_CODE=
EMAIL_COMPANY_CITY=
EMAIL_COMPANY_COUNTRY=
EMAIL_COMPANY_VAT_ID=
EMAIL_COMPANY_EMAIL=

# Outgoing webhooks (fleet admins, admin/webhooks)
WEBHOOK_ALLOW_INSECURE_HTTP=false
WEBHOOK_ALLOW_INTERNAL_HOST=false
WEBHOOK_CHAT_THROTTLE_MS=
WEBHOOK_DELIVERY_LOG_MAX_ENTRIES=
WEBHOOK_DELIVERY_LOG_RETENTION_DAYS=
WEBHOOK_DELIVERY_RETENTION_INTERVAL_MS=

# OpenTelemetry (disabled by default — set OTEL_ENABLED=true and credentials to enable)
OTEL_ENABLED=false
OTEL_USERNAME=
OTEL_PASSWORD=
OTEL_METRICS_PATH=/otel/metrics
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Release metadata
VERSION=
INSTANCE_ID=
