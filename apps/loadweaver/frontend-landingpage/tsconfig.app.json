{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "types": ["node"]
  },
  "files": [
    "src/main.ts",
    "src/main.server.ts",
    "src/server.ts",
    "src/polyfills.ts"
  ],
  "include": ["src/**/*.d.ts", "src/delegating-server.ts"],
  "exclude": [
    "jest.config.cts",
    "src/test-setup.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
