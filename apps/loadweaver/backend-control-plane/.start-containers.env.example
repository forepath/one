# Local-only defaults for the container stack. Replace placeholders before exposing it.
HOST=0.0.0.0
PORT=3400
NODE_ENV=development
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=loadweaver

# Encrypts the cluster CA key and other secrets at rest (32 bytes, base64).
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# AUTHENTICATION_METHOD: api-key | keycloak | users
AUTHENTICATION_METHOD=api-key
STATIC_API_KEY=local-development-loadweaver-api-key
JWT_SECRET=local-development-loadweaver-jwt-secret-change-before-deployment
PRODUCT_NAME=Loadweaver

CORS_ORIGIN=http://localhost:4602

# Cluster identity (generated on first start when empty)
LOADWEAVER_CLUSTER_ID=
LOADWEAVER_CLUSTER_NAME=

# Node agent stream (mTLS gRPC): port, hostnames in the serving certificate, endpoints handed to joining nodes
LOADWEAVER_GRPC_PORT=7443
LOADWEAVER_GRPC_HOSTNAMES=localhost
LOADWEAVER_GRPC_ENDPOINTS=localhost:7443
