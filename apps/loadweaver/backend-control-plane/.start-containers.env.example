# Local-only defaults for the container stack. Replace placeholders before exposing it.
# Application and database ports
HOST=0.0.0.0
PORT=3400
NODE_ENV=development

# Database configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=loadweaver
# TypeORM log levels (comma-separated, e.g. error,warn,query); empty uses the defaults
TYPEORM_LOGGING=
TYPEORM_LOG_QUERIES=
TYPEORM_LOG_PARAMETERS=
TYPEORM_LOG_QUERY_MAXLEN=

# CORS configuration (comma-separated list of allowed origins)
# Socket.IO resolves WEBSOCKET_CORS_ORIGIN → CORS_ORIGIN → *
CORS_ORIGIN=http://localhost:4602
WEBSOCKET_CORS_ORIGIN=

# Encrypts the cluster CA key and other secrets at rest (32 bytes, base64)
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Authentication method: api-key | keycloak | users (default: api-key)
# - api-key: Static API key auth (requires STATIC_API_KEY)
# - keycloak: Keycloak OAuth2 (requires Keycloak env vars)
# - users: Built-in user registration with JWT (requires JWT_SECRET)
AUTHENTICATION_METHOD=users

# Environment variables for disabling signup
DISABLE_SIGNUP=false
# When false (default), users-mode login requires email OTP (or TOTP if enrolled).
DISABLE_FORCE_LOGIN_2FA=false

# Environment variables for static API key authentication (when AUTHENTICATION_METHOD=api-key)
STATIC_API_KEY=local-development-loadweaver-api-key

# Environment variables for users authentication (when AUTHENTICATION_METHOD=users)
JWT_SECRET=local-development-loadweaver-jwt-secret-change-before-deployment
# TOTP issuer shown in authenticator apps (otpauth label). Defaults to Forepath when unset.
PRODUCT_NAME=Loadweaver

# Environment variables for Keycloak authentication (when AUTHENTICATION_METHOD=keycloak)
KEYCLOAK_SERVER_URL=
KEYCLOAK_AUTH_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TOKEN_VALIDATION=online

# Rate limiting (empty = enabled in production only)
RATE_LIMIT_ENABLED=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Cluster identity (generated on first start when empty)
LOADWEAVER_CLUSTER_ID=
LOADWEAVER_CLUSTER_NAME=
# Public URL of the API and console (links in emails, Git plan comments, reports); console URL falls back to it
LOADWEAVER_PUBLIC_URL=http://localhost:3400
LOADWEAVER_CONSOLE_URL=http://localhost:4602
# Optional fixed join token for the first node (otherwise create one in the console / CLI)
LOADWEAVER_BOOTSTRAP_JOIN_TOKEN=

# Node agent stream (mTLS gRPC): port, hostnames in the serving certificate, endpoints handed to joining nodes
LOADWEAVER_GRPC_ENABLED=true
LOADWEAVER_GRPC_PORT=7443
LOADWEAVER_GRPC_HOSTNAMES=localhost
LOADWEAVER_GRPC_ENDPOINTS=localhost:7443

# Platform Postgres credentials rendered for control-plane members (empty = generated per cluster)
LOADWEAVER_POSTGRES_ADMIN_PASSWORD=
LOADWEAVER_POSTGRES_REPLICATION_PASSWORD=

# External KMS for the master key (empty = Shamir shares sealed on the nodes)
# LOADWEAVER_MASTER_KEY_KMS: vault-transit | <plugin provider id>
LOADWEAVER_MASTER_KEY_KMS=
LOADWEAVER_VAULT_TRANSIT_KEY=
LOADWEAVER_VAULT_TRANSIT_MOUNT=transit
VAULT_ADDR=
VAULT_TOKEN=
DYNAMIC_KMS_PROVIDERS=
# Device posture plugins beyond the built-in MDM / EDR ones (3.31)
DYNAMIC_POSTURE_PLUGINS=

# Socket.IO namespaces
LOADWEAVER_PLANS_WEBSOCKET_NAMESPACE=socket/plans
LOADWEAVER_LOGS_WEBSOCKET_NAMESPACE=socket/logs
LOADWEAVER_TERMINALS_WEBSOCKET_NAMESPACE=socket/terminals
LOADWEAVER_EXEC_WEBSOCKET_NAMESPACE=socket/exec
LOADWEAVER_TUNNELS_WEBSOCKET_NAMESPACE=socket/tunnels
LOADWEAVER_TOPOLOGY_WEBSOCKET_NAMESPACE=socket/topology

# Background controllers (on | off)
LOADWEAVER_WORKLOAD_CONTROLLER=on
LOADWEAVER_AUTOSCALER=on
LOADWEAVER_OBJECT_STORE=on
LOADWEAVER_MIGRATION_SESSIONS=on
LOADWEAVER_IMPORT_CONTROLLER=on
LOADWEAVER_GIT_SYNC=on
LOADWEAVER_BACKUPS=on
LOADWEAVER_ROLLOUT_CONTROLLER=on
LOADWEAVER_UPDATE_POLICY=on
LOADWEAVER_UPDATE_CHECK=on
LOADWEAVER_POSTGRES_CERTIFICATE_RENEWAL=on

# Plans and live migration
LOADWEAVER_APPLY_TIMEOUT_MS=600000
LOADWEAVER_LIVE_MIGRATION_FREEZE_BUDGET_MS=3000
LOADWEAVER_LIVE_MIGRATION_LINK_BPS=1000000000
LOADWEAVER_LIVE_MIGRATION_DIRTY_FRACTION=0.05

# Git sync and plan bot
LOADWEAVER_GIT_AUTHOR_NAME=Loadweaver
LOADWEAVER_GIT_AUTHOR_EMAIL=loadweaver@localhost
LOADWEAVER_GIT_CONCURRENCY=4
LOADWEAVER_GIT_BOT_COMMANDS_PER_10MIN=10

# Backups (Kopia) and recovery kit
LOADWEAVER_BACKUP_KIT_SHARES=3
LOADWEAVER_BACKUP_KIT_THRESHOLD=2
LOADWEAVER_BACKUP_DELETION_DELAY_HOURS=72
# Kopia command as a JSON array of strings (empty = kopia from the image)
LOADWEAVER_KOPIA_COMMAND=

# Platform backups (WAL-G, OpenSearch / etcd snapshots) through the append-only S3 gateway
# LOADWEAVER_PLATFORM_BACKUPS: on | off | empty (= on when the gateway listens)
LOADWEAVER_PLATFORM_BACKUPS=
# host:port the S3 gateway listens on (empty = no gateway, e.g. in this local stack)
LOADWEAVER_BACKUP_GATEWAY_LISTEN=
LOADWEAVER_BACKUP_GATEWAY_PORT=7480
LOADWEAVER_ETCD_ENDPOINT=http://127.0.0.1:2379
LOADWEAVER_PLATFORM_COPY_INTERVAL_MS=300000
LOADWEAVER_PLATFORM_CUTOVER_TIMEOUT_MS=1800000
LOADWEAVER_PLATFORM_RESTORE_TIMEOUT_MS=21600000
LOADWEAVER_PLATFORM_CLONE_SSL=require

# Updates and release bundles
LOADWEAVER_RELEASES_REPOSITORY=forepath/one
LOADWEAVER_UPDATE_CHECK_CRON=17 */6 * * *
LOADWEAVER_UPDATE_SETTLE_SECONDS=60
LOADWEAVER_BUNDLE_MAX_BYTES=17179869184
# Node agent binaries served to installers (filled from the release bundle)
LOADWEAVER_AGENT_BINARY_DIR=
# Override of the apt upstreams (JSON array; empty = derived from the nodes' OS / architecture)
LOADWEAVER_APT_SOURCES=
# Development only: accept unsigned bundles (ignored with NODE_ENV=production unless the second flag is i-understand)
LOADWEAVER_ALLOW_UNSIGNED_BUNDLES=false
LOADWEAVER_ALLOW_UNSIGNED_BUNDLES_IN_PRODUCTION=
UPDATE_CHECK_GITHUB_TOKEN=

# Reports and GeoIP
LOADWEAVER_REPORTS_CRON=0 3 1 * *
# Posture integration syncs: coordinator schedule (each integration has its own interval)
LOADWEAVER_POSTURE_SYNC_CRON=*/2 * * * *
# DB-IP Lite country database (empty = bundled file, if present)
LOADWEAVER_GEOIP_DB=

# Redis / BullMQ (Valkey in docker-compose)
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=loadweaver
REDIS_CACHE_ENABLED=
QUEUE_ROLE=all
QUEUE_WORKER_CONCURRENCY=5
QUEUE_BULL_BOARD_ENABLED=true
QUEUE_BULL_BOARD_PATH=/admin/queues
QUEUE_BULL_BOARD_USERNAME=admin
QUEUE_BULL_BOARD_PASSWORD=local-development-bull-board-password

# SMTP / transactional email (MailHog when using docker-compose)
# SMTP_HOST=mailhog and SMTP_PORT=1025 are used by default when running in Docker
# For production SMTP: set SMTP_USER and SMTP_PASSWORD; use port 465 for SMTPS
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_HOST_PORT=1027
MAILHOG_HOST_PORT=8027
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@localhost
EMAIL_COMPANY_NAME=
EMAIL_COMPANY_ADDRESS_LINE1=
EMAIL_COMPANY_POSTAL_CODE=
EMAIL_COMPANY_CITY=
EMAIL_COMPANY_COUNTRY=
EMAIL_COMPANY_VAT_ID=
EMAIL_COMPANY_EMAIL=

# Outgoing webhooks
WEBHOOK_ALLOW_INSECURE_HTTP=false
WEBHOOK_ALLOW_INTERNAL_HOST=false
WEBHOOK_CHAT_THROTTLE_MS=
WEBHOOK_DELIVERY_LOG_MAX_ENTRIES=
WEBHOOK_DELIVERY_LOG_RETENTION_DAYS=
WEBHOOK_DELIVERY_RETENTION_INTERVAL_MS=

# OpenSearch (search indexes, log / audit mirror); disabled in this local stack
OPENSEARCH_ENABLED=false
OPENSEARCH_NODE=
OPENSEARCH_HOST=
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=loadweaver
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=true

# OpenTelemetry (disabled by default — set OTEL_ENABLED=true and credentials to enable)
OTEL_ENABLED=false
OTEL_USERNAME=
OTEL_PASSWORD=
OTEL_METRICS_PATH=/otel/metrics
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Application version and instance id (shown in the console, used by update checks)
VERSION=
INSTANCE_ID=
