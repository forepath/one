# Local-only defaults for the container stack. Replace placeholders before exposing it.
# Server
HOST=0.0.0.0
PORT=3300
NODE_ENV=development

# CORS configuration (comma-separated list of allowed origins)
# Example: CORS_ORIGIN=http://localhost:4101,http://localhost:4200,http://localhost:4300,https://forepath.io
CORS_ORIGIN=http://localhost:4101,http://localhost:4200,http://localhost:4300

# Rate limiting (optional overrides)
RATE_LIMIT_ENABLED=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Cloudflare Turnstile (required in production)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Chatwoot Application API (required in production)
CHATWOOT_BASE_URL=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# OpenTelemetry (disabled by default — set OTEL_ENABLED=true and credentials to enable)
OTEL_ENABLED=false
OTEL_USERNAME=
OTEL_PASSWORD=
OTEL_METRICS_PATH=/otel/metrics
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
