{
  "name": "agenstra-agent-context-mcp",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/agenstra/agent-context-mcp/src",
  "projectType": "application",
  "tags": ["domain:agenstra", "type:app", "scope:backend"],
  "implicitDependencies": ["agenstra-shared-util-opencode-config"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/agenstra/agent-context-mcp"],
      "options": {
        "commands": [
          "npx esbuild apps/agenstra/agent-context-mcp/src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/apps/agenstra/agent-context-mcp/agenstra-context-mcp.cjs --tsconfig=apps/agenstra/agent-context-mcp/tsconfig.app.json --legal-comments=none"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/agenstra/agent-context-mcp/jest.config.ts"
      }
    }
  }
}
