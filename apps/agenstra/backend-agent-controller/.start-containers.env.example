# Local-only defaults for the container stack. Replace placeholders before exposing it.
HOST=0.0.0.0
PORT=3100
NODE_ENV=development
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres

# Environment variables for the provisioning providers
HETZNER_API_TOKEN=
DIGITALOCEAN_API_TOKEN=

# Environment variables for encryption
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Client workspace endpoint SSRF guardrails (agent-manager base URLs stored per client)
# Production: set CLIENT_ENDPOINT_ALLOWED_HOSTS to comma-separated hostnames or * (see docs).
# CLIENT_ENDPOINT_ALLOWED_HOSTS=partner.example.com,am.other-customer.example
# CLIENT_ENDPOINT_ALLOW_INSECURE_HTTP=false
# CLIENT_ENDPOINT_ALLOW_INTERNAL_HOST=false
# CLIENT_ENDPOINT_TLS_REJECT_UNAUTHORIZED=true

# CORS (HTTP uses CORS_ORIGIN; Socket.IO/VNC resolve WEBSOCKET_CORS_ORIGIN → CORS_ORIGIN → *)
# Example: CORS_ORIGIN=http://localhost:4100
CORS_ORIGIN=http://localhost:4100
WEBSOCKET_CORS_ORIGIN=
WEBSOCKET_NAMESPACE=socket/clients

# Environment variables for the authentication method
# AUTHENTICATION_METHOD: api-key | keycloak | users (default: api-key when STATIC_API_KEY set, else keycloak)
# - api-key: Static API key auth (requires STATIC_API_KEY)
# - keycloak: Keycloak OAuth2 (requires Keycloak env vars)
# - users: Built-in user registration with JWT (requires JWT_SECRET)
AUTHENTICATION_METHOD=api-key

# Environment variables for disabling signup
DISABLE_SIGNUP=false
# When false (default), users-mode login requires email OTP (or TOTP if enrolled).
DISABLE_FORCE_LOGIN_2FA=false

# Environment variables for static API key authentication (when AUTHENTICATION_METHOD=api-key)
STATIC_API_KEY=local-development-agent-controller-api-key

# Environment variables for users authentication (when AUTHENTICATION_METHOD=users)
JWT_SECRET=local-development-agent-controller-jwt-secret-change-before-deployment
# TOTP issuer shown in authenticator apps (otpauth label). Defaults to Forepath when unset.
PRODUCT_NAME=Agenstra

# SMTP configuration (MailHog when using docker-compose)
# SMTP_HOST=mailhog and SMTP_PORT=1025 are used by default when running in Docker
# For production SMTP: set SMTP_USER and SMTP_PASSWORD; use port 465 for SMTPS
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_HOST_PORT=1025
MAILHOG_HOST_PORT=8025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@localhost
# Optional brand block in transactional emails (falls back to BILLING_ISSUER_* if set)
EMAIL_COMPANY_NAME=
EMAIL_COMPANY_ADDRESS_LINE1=
EMAIL_COMPANY_POSTAL_CODE=
EMAIL_COMPANY_CITY=
EMAIL_COMPANY_COUNTRY=
EMAIL_COMPANY_VAT_ID=
EMAIL_COMPANY_EMAIL=

# Redis / BullMQ (queue provider in docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=agenstra-controller
REDIS_HOST_PORT=6379
QUEUE_ROLE=all
QUEUE_WORKER_CONCURRENCY=5
QUEUE_BULL_BOARD_ENABLED=true
QUEUE_BULL_BOARD_PATH=/admin/queues
QUEUE_BULL_BOARD_USERNAME=admin
QUEUE_BULL_BOARD_PASSWORD=bullmq

# OpenSearch (search indexes)
OPENSEARCH_ENABLED=true
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=agenstra
OPENSEARCH_HOST_PORT=9200
SEARCH_REINDEX_INTERVAL=15m
SEARCH_REINDEX_BATCH_SIZE=100

# OpenTelemetry (disabled by default — set OTEL_ENABLED=true and credentials to enable)
OTEL_ENABLED=false
OTEL_USERNAME=
OTEL_PASSWORD=
OTEL_METRICS_PATH=/otel/metrics
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Application version and update checks
VERSION=
INSTANCE_ID=
UPDATE_CHECK_GITHUB_TOKEN=
UPDATE_CHECK_CRON=0 0 * * *
UPDATE_CHECK_TIMEZONE=Europe/Berlin

# MCP authentication callback security
MCP_OAUTH_PUBLIC_BASE_URL=http://localhost:3100
MCP_OAUTH_CALLBACK_SECRET=local-development-mcp-callback-secret-change-before-deployment

# Remaining explicit Compose defaults
AUTO_ENRICH_ENABLED_GLOBAL=true
AUTO_ENRICH_VECTOR_ENABLED=true
AUTO_ENRICH_MAX_SECTIONS=6
AUTO_ENRICH_MAX_CHARS=12000
AUTO_ENRICH_VECTOR_TOP_K=20
AUTO_ENRICH_VECTOR_MAX_COSINE_DISTANCE=1
KNOWLEDGE_EMBEDDINGS_REINDEX_INTERVAL_MS=3600000
CONTEXT_IMPORT_SCHEDULER_INTERVAL_MS=120000
CONTEXT_IMPORT_SCHEDULER_CONFIG_BATCH=3
CONTEXT_IMPORT_ITEM_BUDGET=25
FILTER_RULES_SYNC_INTERVAL_MS=30000
FILTER_RULES_SYNC_BATCH_SIZE=10
AUTONOMOUS_TICKET_SCHEDULER_INTERVAL_MS=60000
AUTONOMOUS_TICKET_SCHEDULER_BATCH_SIZE=5
DYNAMIC_PROVISIONING_PROVIDERS=
DYNAMIC_CONTEXT_IMPORT_PROVIDERS=
DYNAMIC_PROVIDERS_FAIL_FAST=false
DYNAMIC_PROVIDER_PLUGIN_PATH=
DYNAMIC_PROVIDER_PLUGIN_INSTALL=
CLIENT_ENDPOINT_ALLOWED_HOSTS=
CLIENT_ENDPOINT_ALLOW_INSECURE_HTTP=false
CLIENT_ENDPOINT_ALLOW_INTERNAL_HOST=false
CLIENT_ENDPOINT_TLS_REJECT_UNAUTHORIZED=true
KEYCLOAK_SERVER_URL=
KEYCLOAK_AUTH_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TOKEN_VALIDATION=online
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
RATE_LIMIT_ENABLED=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
