# -----------------------------------------------------------------------------
# Image:      agenstra-manager-ssh
# Project:    backend-agent-manager — Nx target `ssh-container-image`
# Registry:   ghcr.io/forepath/agenstra-manager-ssh
# Base:       debian:trixie-slim
# User:       agenstra (APP_UID / APP_GID, default 10001); entrypoint starts as root,
#             chowns /app, sets password, starts sshd, then drops via setpriv (no sudo)
# Exposes:    22 (SSH)
# Build:      npx nx run backend-agent-manager:ssh-container-image
# Run:        —
# Notes:      Required runtime env: SSH_PASSWORD
#             Workspace: /app (bind mount). Home: /home/agenstra (credentials).
# -----------------------------------------------------------------------------
#
FROM docker.io/debian:trixie-slim

ARG APP_UID=10001
ARG APP_GID=10001
ARG VERSION=0.0.0
ENV VERSION=${VERSION}
ENV HOME=/home/agenstra

WORKDIR /app

RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends \
    curl \
    bash \
    ca-certificates \
    openssh-server \
    util-linux \
    sshpass && \
    groupadd --gid "${APP_GID}" agenstra && \
    useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --home-dir /home/agenstra --shell /bin/bash agenstra && \
    chown agenstra:agenstra /app /home/agenstra && \
    mkdir -p /var/run/sshd && \
    sed -i -E 's/^#?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i -E 's/^#?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -euo pipefail' \
    'chown -R agenstra:agenstra /app 2>/dev/null || true' \
    'if [ -z "${SSH_PASSWORD:-}" ]; then' \
    '  echo "SSH_PASSWORD is required" >&2' \
    '  exit 1' \
    'fi' \
    'echo "agenstra:${SSH_PASSWORD}" | chpasswd' \
    '/usr/sbin/sshd' \
    'exec setpriv --reuid=agenstra --regid=agenstra --init-groups -- tail -f /dev/null' \
    > /usr/local/bin/docker-entrypoint.sh && \
    chmod 755 /usr/local/bin/docker-entrypoint.sh

EXPOSE 22

# Entrypoint runs as root for chown/chpasswd/sshd, then drops to agenstra via setpriv.
USER root

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
