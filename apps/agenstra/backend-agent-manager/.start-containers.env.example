# Local-only defaults for the container stack. Replace placeholders before exposing it.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
WEBSOCKET_NAMESPACE=socket/agents
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres

# Environment variables for the cursor-agent
CURSOR_API_KEY=

# Environment variables for the git repository
GIT_REPOSITORY_URL=
GIT_USERNAME=
GIT_TOKEN=
GIT_PRIVATE_KEY=

# Environment variables for encryption (base64-encoded 32-byte AES-256 key)
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Worker image (must run `opencode serve`). Rebuild locally after Dockerfile.worker changes:
#   docker build -f apps/agenstra/backend-agent-manager/Dockerfile.worker \
#     -t ghcr.io/forepath/agenstra-manager-worker:latest apps/agenstra/backend-agent-manager
# Prefer a local tag while developing so a registry pull cannot clobber it.
AGENT_DEFAULT_IMAGE=ghcr.io/forepath/agenstra-manager-worker:latest
OPENCODE_AGENT_DOCKER_IMAGE=ghcr.io/forepath/agenstra-manager-worker:latest

# CORS (HTTP uses CORS_ORIGIN; Socket.IO/VNC resolve WEBSOCKET_CORS_ORIGIN → CORS_ORIGIN → *)
# Example: CORS_ORIGIN=http://localhost:4100
CORS_ORIGIN=http://localhost:4100
WEBSOCKET_CORS_ORIGIN=

# Environment variables for static API key authentication
# If STATIC_API_KEY is set, API key authentication is used (no Keycloak fallback)
# If STATIC_API_KEY is not set, Keycloak authentication is used
STATIC_API_KEY=local-development-agent-manager-api-key

# Environment variables for users authentication (when AUTHENTICATION_METHOD=users)
JWT_SECRET=local-development-agent-manager-jwt-secret-change-before-deployment

# Application version (reported by GET /api/instance-status)
VERSION=
INSTANCE_ID=
AGENT_MANAGER_ROLE=api

# OpenTelemetry (disabled by default — set OTEL_ENABLED=true and credentials to enable)
OTEL_ENABLED=false
OTEL_USERNAME=
OTEL_PASSWORD=
OTEL_METRICS_PATH=/otel/metrics
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Remaining explicit Compose defaults
AGENT_DOCKER_NETWORK=agent-manager-network
DOCKER_HOST_GATEWAY=host.docker.internal
DYNAMIC_PIPELINE_PROVIDERS=
DYNAMIC_CHAT_FILTERS=
DYNAMIC_PROVIDERS_FAIL_FAST=false
DYNAMIC_PROVIDER_PLUGIN_PATH=
DYNAMIC_PROVIDER_PLUGIN_INSTALL=
GIT_PASSWORD=
KEYCLOAK_SERVER_URL=
KEYCLOAK_AUTH_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TOKEN_VALIDATION=online
RATE_LIMIT_ENABLED=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
