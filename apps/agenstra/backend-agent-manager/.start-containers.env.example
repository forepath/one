# Local-only defaults for the container stack. Replace placeholders before exposing it.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
WEBSOCKET_NAMESPACE=socket/agents
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres

# Environment variables for the cursor-agent
CURSOR_API_KEY=

# Environment variables for the git repository
GIT_REPOSITORY_URL=
GIT_USERNAME=
GIT_TOKEN=
GIT_PRIVATE_KEY=

# Environment variables for encryption (base64-encoded 32-byte AES-256 key)
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Worker image (must run `opencode serve`). `start-containers` builds the local test worker
# (`worker-container-image:test`) under the internal-registry tag below, so freshly started
# environments always use the current Dockerfile.worker / entrypoint instead of a stale release.
AGENT_DEFAULT_IMAGE=registry.forenet.internal/forepath/agenstra-manager-worker:test
OPENCODE_AGENT_DOCKER_IMAGE=registry.forenet.internal/forepath/agenstra-manager-worker:test

# Egress guard sidecar image (per-agent web traffic filtering). `start-containers` builds the local
# test image (`egress-guard-container-image:test`) under the internal-registry tag below.
AGENT_EGRESS_GUARD_IMAGE=registry.forenet.internal/forepath/agenstra-manager-egress-guard:test
AGENT_EGRESS_GUARD_ENABLED=true
AGENT_EGRESS_GUARD_MEMORY_MB=256
AGENT_EGRESS_EVENTS_COLLECTOR_ENABLED=true
AGENT_EGRESS_EVENTS_POLL_INTERVAL_MS=15000
AGENT_EGRESS_EVENTS_RETENTION_HOURS=72
# Git over SSH (TCP 22) through the egress guard: curated providers (GitHub, GitLab, Bitbucket, Azure
# DevOps, Codeberg, ...) are always allowed; add self-hosted Git servers (comma separated host names).
AGENT_EGRESS_GIT_SSH_ENABLED=true
AGENT_EGRESS_GIT_SSH_HOSTS=

# Container isolation levels. `sandboxed` (gVisor) is offered only when the Docker runtime below is
# registered on the host and passes the isolation probe; `standard` (runc) is always the floor.
# Leave AGENT_ISOLATION_PROBE_IMAGE empty to probe with the worker image.
AGENT_SANDBOX_RUNTIME=runsc-systrap
# gVisor variant for workers joining their egress guard's network namespace (--network=host).
AGENT_SANDBOX_SHARED_NETNS_RUNTIME=runsc-systrap-hostnet
AGENT_ISOLATION_SANDBOX_ENABLED=true
AGENT_ISOLATION_PROBE_ENABLED=true
AGENT_ISOLATION_PROBE_INTERVAL_MS=21600000
AGENT_ISOLATION_PROBE_TIMEOUT_MS=90000
AGENT_ISOLATION_PROBE_IMAGE=
AGENT_ISOLATION_FAILURE_THRESHOLD=3

# CORS (HTTP uses CORS_ORIGIN; Socket.IO/VNC resolve WEBSOCKET_CORS_ORIGIN → CORS_ORIGIN → *)
# Example: CORS_ORIGIN=http://localhost:4100
CORS_ORIGIN=http://localhost:4100
WEBSOCKET_CORS_ORIGIN=

# Environment variables for static API key authentication
# If STATIC_API_KEY is set, API key authentication is used (no Keycloak fallback)
# If STATIC_API_KEY is not set, Keycloak authentication is used
STATIC_API_KEY=local-development-agent-manager-api-key

# Environment variables for users authentication (when AUTHENTICATION_METHOD=users)
JWT_SECRET=local-development-agent-manager-jwt-secret-change-before-deployment

# Application version (reported by GET /api/instance-status)
VERSION=
INSTANCE_ID=
AGENT_MANAGER_ROLE=api

# OpenTelemetry (disabled by default — set OTEL_ENABLED=true and credentials to enable)
OTEL_ENABLED=false
OTEL_USERNAME=
OTEL_PASSWORD=
OTEL_METRICS_PATH=/otel/metrics
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Remaining explicit Compose defaults
AGENT_DOCKER_NETWORK=agent-manager-network
DOCKER_HOST_GATEWAY=host.docker.internal
DYNAMIC_PIPELINE_PROVIDERS=
DYNAMIC_CHAT_FILTERS=
DYNAMIC_PROVIDERS_FAIL_FAST=false
DYNAMIC_PROVIDER_PLUGIN_PATH=
DYNAMIC_PROVIDER_PLUGIN_INSTALL=
GIT_PASSWORD=
KEYCLOAK_SERVER_URL=
KEYCLOAK_AUTH_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TOKEN_VALIDATION=online
RATE_LIMIT_ENABLED=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
