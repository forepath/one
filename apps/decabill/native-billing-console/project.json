{
  "name": "decabill-native-billing-console",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/decabill/native-billing-console/src",
  "tags": ["domain:decabill", "type:app", "scope:native"],
  "implicitDependencies": ["decabill-frontend-billing-console"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/decabill/native-billing-console",
        "{workspaceRoot}/dist/apps/decabill/frontend-billing-console"
      ],
      "configurations": {
        "development": {
          "commands": [
            "nx build decabill-frontend-billing-console --configuration=development",
            "nx run decabill-frontend-billing-console:prebuild-server --configuration=development",
            "nx run decabill-frontend-billing-console:server",
            "tsc -p apps/decabill/native-billing-console/tsconfig.json",
            "rm -rf dist/apps/decabill/native-billing-console",
            "npx esbuild apps/decabill/native-billing-console/src/main.ts apps/decabill/native-billing-console/src/preload.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --log-level=warning --outdir=dist/apps/decabill/native-billing-console",
            "node -e \"require('fs').writeFileSync('dist/apps/decabill/native-billing-console/package.json', JSON.stringify({type:'commonjs'}, null, 2))\"",
            "cp -r dist/apps/decabill/frontend-billing-console/server dist/apps/decabill/native-billing-console/server",
            "cp apps/decabill/native-billing-console/package-server.json dist/apps/decabill/native-billing-console/server/package.json",
            "npm i --omit=dev --prefix dist/apps/decabill/native-billing-console/server",
            "cp apps/decabill/native-billing-console/public/assets/images/icon.ico dist/apps/decabill/native-billing-console/icon.ico",
            "cp apps/decabill/native-billing-console/public/assets/images/icon.png dist/apps/decabill/native-billing-console/icon.png",
            "cp apps/decabill/native-billing-console/package.json dist/apps/decabill/native-billing-console/package.json",
            "cp apps/decabill/native-billing-console/forge.config.js dist/apps/decabill/native-billing-console/forge.config.js",
            "npm i --omit=dev --prefix dist/apps/decabill/native-billing-console"
          ]
        },
        "production": {
          "commands": [
            "nx build decabill-frontend-billing-console --configuration=production",
            "nx run decabill-frontend-billing-console:prebuild-server --configuration=production",
            "nx run decabill-frontend-billing-console:server",
            "tsc -p apps/decabill/native-billing-console/tsconfig.json",
            "rm -rf dist/apps/decabill/native-billing-console",
            "npx esbuild apps/decabill/native-billing-console/src/main.ts apps/decabill/native-billing-console/src/preload.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --log-level=warning --outdir=dist/apps/decabill/native-billing-console",
            "node -e \"require('fs').writeFileSync('dist/apps/decabill/native-billing-console/package.json', JSON.stringify({type:'commonjs'}, null, 2))\"",
            "cp -r dist/apps/decabill/frontend-billing-console/server dist/apps/decabill/native-billing-console/server",
            "cp apps/decabill/native-billing-console/package-server.json dist/apps/decabill/native-billing-console/server/package.json",
            "npm i --omit=dev --prefix dist/apps/decabill/native-billing-console/server",
            "cp apps/decabill/native-billing-console/public/assets/images/icon.ico dist/apps/decabill/native-billing-console/icon.ico",
            "cp apps/decabill/native-billing-console/public/assets/images/icon.png dist/apps/decabill/native-billing-console/icon.png",
            "cp apps/decabill/native-billing-console/package.json dist/apps/decabill/native-billing-console/package.json",
            "cp apps/decabill/native-billing-console/forge.config.js dist/apps/decabill/native-billing-console/forge.config.js",
            "npm i --omit=dev --prefix dist/apps/decabill/native-billing-console"
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false
      },
      "configurations": {
        "development": {
          "commands": [
            "nx build decabill-native-billing-console --configuration=development",
            "electron dist/apps/decabill/native-billing-console/main.js"
          ]
        },
        "production": {
          "commands": [
            "nx build decabill-native-billing-console --configuration=production",
            "electron dist/apps/decabill/native-billing-console/main.js"
          ]
        }
      },
      "defaultConfiguration": "development"
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false
      },
      "configurations": {
        "development-linux": {
          "commands": [
            "nx build decabill-native-billing-console --configuration=development",
            "cd dist/apps/decabill/native-billing-console && npx electron-forge make --platform linux"
          ]
        },
        "development-windows": {
          "commands": [
            "nx build decabill-native-billing-console --configuration=development",
            "cd dist/apps/decabill/native-billing-console && npx electron-forge make --platform win32"
          ]
        },
        "production-linux": {
          "commands": [
            "nx build decabill-native-billing-console --configuration=production",
            "sed -i \"s/0.0.0/${RELEASE_VERSION}/g\" dist/apps/decabill/native-billing-console/package.json",
            "sed -i \"s/0.0.0/${RELEASE_VERSION}/g\" dist/apps/decabill/native-billing-console/server/package.json",
            "cd dist/apps/decabill/native-billing-console && npx electron-forge make --platform linux"
          ]
        },
        "production-macos": {
          "commands": [
            "nx build decabill-native-billing-console --configuration=production",
            "node -e \"const f=require('fs');for(const p of process.argv.slice(1)){const j=JSON.parse(f.readFileSync(p,'utf8'));j.version=process.env.RELEASE_VERSION;f.writeFileSync(p,JSON.stringify(j,null,2));}\" dist/apps/decabill/native-billing-console/package.json dist/apps/decabill/native-billing-console/server/package.json",
            "cd dist/apps/decabill/native-billing-console && npx electron-forge package --platform darwin --arch ${ELECTRON_FORGE_ARCH:-arm64}"
          ]
        },
        "production-windows": {
          "commands": [
            "nx build decabill-native-billing-console --configuration=production",
            "sed -i \"s/0.0.0/${RELEASE_VERSION}/g\" dist/apps/decabill/native-billing-console/package.json",
            "sed -i \"s/0.0.0/${RELEASE_VERSION}/g\" dist/apps/decabill/native-billing-console/server/package.json",
            "cd dist/apps/decabill/native-billing-console && npx electron-forge make --platform win32"
          ]
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/decabill/native-billing-console/jest.config.ts"
      }
    },
    "sbom": {
      "executor": "@forepath/sbom:sbom",
      "dependsOn": ["sbom:build", "build"]
    }
  }
}
