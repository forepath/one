# -----------------------------------------------------------------------------
# Image:      decabill-billing-api
# Project:    backend-billing-manager — Nx target `api-container-image`
# Registry:   ghcr.io/forepath/decabill-billing-api
# Base:       debian:trixie-slim
# User:       decabill (APP_UID / APP_GID, default 10001)
# Exposes:    3200 (HTTP API + WebSocket)
# Build:      npx nx run backend-billing-manager:api-container-image
# Run:        nx docker:run decabill-backend-billing-manager -p 3200:3200
# Notes:      Configure via runtime env; see docs/decabill/deployment/
#             Entrypoint runs as root for storage chown, then drops to decabill via runuser.
#             Playwright Chromium is baked in for HTML invoice PDF rendering.
# -----------------------------------------------------------------------------
#
FROM docker.io/debian:trixie-slim

ARG APP_UID=10001
ARG APP_GID=10001
# Release sets VERSION via --build-arg (see api-container-image / release.yml).
ARG VERSION=0.0.0

ENV HOST=0.0.0.0
ENV PORT=3200
ENV NVM_DIR=/home/decabill/.nvm
ENV NODE_VERSION=24.14.1
ENV HOME=/home/decabill
ENV PATH="/home/decabill/.nvm/versions/node/v${NODE_VERSION}/bin:${PATH}"
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV VERSION=${VERSION}

WORKDIR /app

EXPOSE ${PORT}

RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends \
    curl \
    bash \
    ca-certificates \
    gnupg \
    lsb-release \
    util-linux && \
    groupadd --gid "${APP_GID}" decabill && \
    useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --home-dir /home/decabill --shell /bin/bash decabill && \
    chown "${APP_UID}:${APP_GID}" /app && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | PROFILE=/dev/null bash && \
    . "${NVM_DIR}/nvm.sh" && \
    nvm install "${NODE_VERSION}" && \
    nvm alias default "${NODE_VERSION}" && \
    npm install -g npm@11.18.0 && \
    npm cache clean --force && \
    chown -R "${APP_UID}:${APP_GID}" /home/decabill

COPY --chown=${APP_UID}:${APP_GID} package*.json ./

RUN . "${NVM_DIR}/nvm.sh" && \
    npm i && \
    npm cache clean --force && \
    npx playwright install --with-deps chromium && \
    apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    chown -R "${APP_UID}:${APP_GID}" /app "${PLAYWRIGHT_BROWSERS_PATH}"

COPY --chown=${APP_UID}:${APP_GID} . /app

RUN mkdir -p \
      /data/customer/invoices \
      /data/customer/offers \
      /data/customer/timesheets \
      /data/supplier/invoices \
      /data/export/datev \
      /data/invoices \
      /var/lib/forepath/provider-plugins && \
    chown -R "${APP_UID}:${APP_GID}" /data /var/lib/forepath/provider-plugins

# Expand APP_UID/APP_GID into the entrypoint at build time (runtime has no ARG).
RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -euo pipefail' \
    'storage_root="${FILE_STORAGE_ROOT:-/data}"' \
    'mkdir -p \' \
    '  "${storage_root}/customer/invoices" \' \
    '  "${storage_root}/customer/offers" \' \
    '  "${storage_root}/customer/timesheets" \' \
    '  "${storage_root}/supplier/invoices" \' \
    '  "${storage_root}/export/datev" \' \
    '  "${storage_root}/invoices"' \
    "chown -R ${APP_UID}:${APP_GID} \"\${storage_root}\" /var/lib/forepath/provider-plugins" \
    '. "${NVM_DIR}/nvm.sh"' \
    'if [ -n "${DYNAMIC_PROVIDER_PLUGIN_PATH:-}" ]; then' \
    '  runuser -u decabill -g decabill -- node install-provider-plugins.js' \
    'fi' \
    'exec runuser -u decabill -g decabill -- node main.js' \
    > /usr/local/bin/docker-entrypoint.sh && \
    chmod 755 /usr/local/bin/docker-entrypoint.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f "http://localhost:${PORT}/api/health" || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
