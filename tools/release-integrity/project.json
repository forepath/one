{
  "name": "release-integrity",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/release-integrity/src",
  "tags": ["type:tool", "scope:repo"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "tools/release-integrity/dist",
        "main": "tools/release-integrity/src/cli.ts",
        "tsConfig": "tools/release-integrity/tsconfig.lib.json",
        "generatePackageJson": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "tools/release-integrity/jest.config.ts"
      }
    },
    "release-manifest": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx esbuild tools/release-integrity/signing/cli.ts --bundle --platform=node --target=node22 --log-level=warning --outfile=tmp/release-integrity/release-manifest.cjs && node tmp/release-integrity/release-manifest.cjs",
        "forwardAllArgs": true
      }
    },
    "generate-release-key": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx esbuild tools/release-integrity/signing/cli.ts --bundle --platform=node --target=node22 --log-level=warning --outfile=tmp/release-integrity/release-manifest.cjs && node tmp/release-integrity/release-manifest.cjs generate-key",
        "forwardAllArgs": true
      }
    }
  }
}
