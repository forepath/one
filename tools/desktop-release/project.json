{
  "name": "desktop-release",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/desktop-release/src",
  "tags": ["type:tool", "scope:repo"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "tools/desktop-release/jest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsc -p tools/desktop-release/tsconfig.lib.json"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx esbuild tools/desktop-release/src/cli.ts --bundle --platform=node --target=node22 --log-level=warning --external:@electron/osx-sign --external:@electron/notarize --outfile=tmp/desktop-release/desktop-release.cjs"
      }
    },
    "desktop-release": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx esbuild tools/desktop-release/src/cli.ts --bundle --platform=node --target=node22 --log-level=warning --external:@electron/osx-sign --external:@electron/notarize --outfile=tmp/desktop-release/desktop-release.cjs && node tmp/desktop-release/desktop-release.cjs",
        "forwardAllArgs": true
      }
    }
  }
}
